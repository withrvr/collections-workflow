      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Body is literally true', function () {",
                  "    pm.expect(pm.response.json()).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/utils/health-check/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "utils", "health-check", ""]
            },
            "description": "From the base fastapi/full-stack-fastapi-template. Returns `true` when the backend is up and can reach the database. Run this first -- if this fails, nothing below will work."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Runs",
      "item": [
        {
          "name": "Create Run - Dataset A (Blocks)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Postman strips local file paths from imported collections for security.",
                  "// Click the Body tab, click 'Select File' next to the `file` key, and pick:",
                  "//   {{dataset_a_path}}",
                  "// (shown for reference in the Console below).",
                  "console.log('Attach file for this request:', pm.variables.get('dataset_a_path'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 (never 500, even for a run that fails)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const run = pm.response.json();",
                  "",
                  "pm.test('Run has an id and a status', function () {",
                  "    pm.expect(run.id).to.be.a('string');",
                  "    pm.expect(run.status).to.be.oneOf(['PASSED', 'BLOCKED', 'FAILED']);",
                  "});",
                  "",
                  "pm.test('Dataset A blocks the control gate', function () {",
                  "    pm.expect(run.status).to.eql('BLOCKED');",
                  "    pm.expect(run.exception_count).to.eql(17);",
                  "    pm.expect(run.overdue_count).to.eql(15);",
                  "    pm.expect(run.total_outstanding).to.eql('1202000.00');",
                  "});",
                  "",
                  "// Downstream requests in this collection read {{run_id}} --",
                  "// pointing it at this run means 'Reports' folder inspects dataset A by default.",
                  "pm.collectionVariables.set('run_id', run.id);",
                  "pm.collectionVariables.set('blocked_run_id', run.id);",
                  "console.log('run_id set to', run.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Select {{dataset_a_path}} -- the assessment's own workbook. ~45% exception rate, blocks the 5% control gate by design."
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/collections/runs/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "collections", "runs", ""]
            },
            "description": "Upload a workbook and run the full pipeline synchronously: load -> validate -> explain -> calculate -> control gate -> summarise -> persist. Always returns 200 with a Run, whatever happens -- a bad file produces a `FAILED` run in the body, never a 500.\n\nAttach **{{dataset_a_path}}** in the Body tab. This is the assessment's given workbook -- it has real data-quality issues by design (that's the point) and will come back `BLOCKED`."
          },
          "response": []
        },
